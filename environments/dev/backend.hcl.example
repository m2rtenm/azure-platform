# Copy to backend.hcl and replace the storage-account placeholder with the
# bootstrap output. These values are identifiers, not credentials.
resource_group_name  = "rg-tfstate-dev-neu"
storage_account_name = "<bootstrap-storage-account-name>"
container_name       = "tfstate"
key                  = "dev/platform.tfstate"
use_azuread_auth     = true
use_cli              = true
